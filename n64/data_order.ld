/* Generated by n64/profile/dcache_order.py: hot static data, pinned. */
.sdata : {
  . = ALIGN(8192);
  *(.sdata.last.18)
  *(.sdata.s_d9_bytes_ok.37)
  *(.sdata.kPeriods.0)
  *(.sdata.k.1)
  *(.sdata.s_c2w.30)
  *(.sdata.dtrace.41)
